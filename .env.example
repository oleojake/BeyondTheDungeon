# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Cloudflare Turnstile Site Key (for captcha on login/register)
# Get one at https://dash.cloudflare.com -> Turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Backend API URL
# Leave blank for local dev (Vite proxy forwards /api/* to localhost:3000 automatically)
# Set to production URL when deploying: https://beyondthedungeon.org
VITE_API_URL=

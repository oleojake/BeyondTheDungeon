PORT=3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # solo si lo necesitas (server-side)

# ── Email (nodemailer) ────────────────────────────────────────────────────────
# Si no se define SMTP_HOST, los emails se omiten silenciosamente (modo local/dev).
# Para activar el envío real, rellena las 5 variables siguientes.
#
# Ejemplo con Gmail (App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tu@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   # contraseña de aplicación de Google
#
# Ejemplo con servidor propio (Postfix/Exim):
#   SMTP_HOST=mail.tudominio.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=noreply@tudominio.com
#   SMTP_PASS=contraseña

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Beyond The Dungeon <noreply@beyondthedungeon.org>

APP_URL=https://beyondthedungeon.org
